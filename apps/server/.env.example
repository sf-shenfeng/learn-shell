# Copy this to .env (gitignored) — NOT optional: DATABASE_URL has no default in
# the code; db entrypoints refuse to start without it. Values below match
# docker-compose.yml's dev credentials. Note: the MCP stdio entrypoint does not
# read this file — pass DATABASE_URL in the MCP client's own env (SETUP.md §4).

DATABASE_URL=postgresql://learn_shell:learn_shell_dev@localhost:5432/learn_shell

# Hono REST listen port
PORT=3000

# CORS origins (Vite dev = :5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Base URL of the learner-facing web app, used to resolve the relative
# learner_url in tool receipts / manifest://capabilities' learner_app_base_url
# into a clickable link. Defaults to :5173 (Vite dev) if unset.
LEARNER_APP_BASE_URL=http://localhost:5173
